# Copy this file to .env and fill in your values. Never commit .env.

# Preferred. Get a key at https://opencode.ai/console (format oc_sk_...).
# Requires an active OpenCode Go subscription.
OPENCODE_API_KEY=oc_sk_your-key-here

# Optional. Defaults to the OpenCode Go gateway.
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_ANTHROPIC_BASE_URL=https://opencode.ai/inference/go
# OPENCODE_SESSION=ses_your-stable-session-id

# Ordered model list: first = generation, second = reflection.
# Extra entries are ignored. A single entry is reused for both steps.
MODELS=glm-5.3-flash,gemini-4-argon

# Optional explicit overrides, take precedence over MODELS.
# GENERATION_MODEL=glm-5.3-flash
# REFLECTION_MODEL=gemini-4-argon

# Fallback when OPENCODE_API_KEY is not set.
# NOTE: if OPENCODE_API_KEY is set it always wins, even with OPENAI_* defined.
# Comment out OPENCODE_API_KEY before switching providers.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Required only for direct Anthropic access.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---------------------------------------------------------------------------
# Provider switch examples
# ---------------------------------------------------------------------------
# OpenAI
#   OPENCODE_API_KEY is commented out
#   OPENAI_API_KEY=sk-...
#   MODELS=gpt-5.4-mini,gpt-5.4
#
# OpenRouter (or any OpenAI-compatible gateway)
#   OPENCODE_API_KEY is commented out
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   MODELS=openai/gpt-5.4-mini,anthropic/claude-sonnet-4.6
#
# OpenCode Zen (pay-as-you-go, different base URL than Go)
#   OPENCODE_API_KEY=sk-...
#   OPENCODE_BASE_URL=https://opencode.ai/zen/v1
#   OPENCODE_ANTHROPIC_BASE_URL=https://opencode.ai/zen/v1
#   MODELS=gpt-5.4-mini,claude-sonnet-4-6
